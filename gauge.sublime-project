{
	"folders":
	[
		{
			"path": ".",
		},
		{
			"path": "~/.local/share/odin-root",
			"name": "Odin stdlib (core + vendor)",
		}
	],
	"build_systems":
	[
		{
			"name": "Odin: Build",
			"working_dir": "${project_path}",
			"cmd": ["devenv", "shell", "--quiet", "odin", "build", "."],
			"windows": {"cmd": ["cmd", "/C", "odin build ."]},
			"file_regex": "^(...*?)\\(([0-9]+):([0-9]+)\\) (?:Error|Warning|Note): (.*)$",
		},
		{
			"name": "Odin: Run",
			"working_dir": "${project_path}",
			"cmd": ["devenv", "shell", "--quiet", "odin", "run", ".", "--", "demo.gauge"],
			"windows": {"cmd": ["cmd", "/C", "odin run . -- demo.gauge"]},
			"file_regex": "^(...*?)\\(([0-9]+):([0-9]+)\\) (?:Error|Warning|Note): (.*)$",
		},
		{
			"name": "Odin: Debug",
			"working_dir": "${project_path}",
			"cmd": ["bash", "-c", "devenv shell --quiet odin build . -debug && devenv shell --quiet gf2 ./gauge"],
			"windows": {"cmd": ["cmd", "/C", "odin build . -debug && raddbg gauge.exe demo.gauge"]},
			"file_regex": "^(...*?)\\(([0-9]+):([0-9]+)\\) (?:Error|Warning|Note): (.*)$",
		},
		{
			"name": "Odin: Test",
			"working_dir": "${project_path}",
			"cmd": ["bash", "-c", "devenv shell --quiet odin test compiler/"],
			"windows": {"cmd": ["cmd", "/C", "odin test compiler/"]},
			"file_regex": "^(...*?)\\(([0-9]+):([0-9]+)\\) (?:Error|Warning|Note): (.*)$",
		},
		{
			"name": "Odin: Debug tests",
			"working_dir": "${project_path}",
			"cmd": ["bash", "-c", "devenv shell --quiet odin test compiler/ -out:compiler.test.bin -debug && devenv shell --quiet gf2 ./compiler.test.bin"],
			"windows": {"cmd": ["cmd", "/C", "odin test compiler/ -out:compiler.test.bin.exe -debug -keep-executable && raddbg compiler.test.bin.exe"]},
			"file_regex": "^(...*?)\\(([0-9]+):([0-9]+)\\) (?:Error|Warning|Note): (.*)$",
		}
	],
	"debugger_configurations":
	[
	],
}
